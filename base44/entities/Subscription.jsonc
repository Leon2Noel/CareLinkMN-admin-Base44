{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "basic",
        "professional",
        "enterprise"
      ],
      "default": "free"
    },
    "priority_boost_factor": {
      "type": "number",
      "default": 1.0,
      "description": "Paid prominence multiplier: free=1.0, basic=1.05, professional=1.10, enterprise=1.15"
    },
    "status": {
      "type": "string",
      "enum": [
        "trial",
        "active",
        "past_due",
        "cancelled",
        "expired"
      ],
      "default": "trial"
    },
    "trial_ends_at": {
      "type": "string",
      "format": "date"
    },
    "current_period_start": {
      "type": "string",
      "format": "date"
    },
    "current_period_end": {
      "type": "string",
      "format": "date"
    },
    "amount": {
      "type": "number"
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "monthly",
        "annual"
      ],
      "default": "monthly"
    },
    "payment_method": {
      "type": "string"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "stripe_subscription_id": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "max_sites": {
      "type": "number"
    },
    "max_openings": {
      "type": "number"
    },
    "gating_requirements_met": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "organization_id",
    "plan"
  ]
}