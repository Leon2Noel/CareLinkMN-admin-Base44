{
  "name": "NotificationPreference",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User these preferences belong to"
    },
    "channel_in_app": {
      "type": "boolean",
      "default": true
    },
    "channel_email": {
      "type": "boolean",
      "default": true
    },
    "channel_sms": {
      "type": "boolean",
      "default": false
    },
    "referral_updates_enabled": {
      "type": "boolean",
      "default": true
    },
    "opening_match_enabled": {
      "type": "boolean",
      "default": true
    },
    "messages_enabled": {
      "type": "boolean",
      "default": true
    },
    "opening_match_frequency": {
      "type": "string",
      "enum": [
        "realtime",
        "daily_digest",
        "weekly_digest"
      ],
      "default": "realtime"
    },
    "quiet_hours_enabled": {
      "type": "boolean",
      "default": false
    },
    "quiet_hours_start": {
      "type": "string",
      "description": "24h format HH:MM"
    },
    "quiet_hours_end": {
      "type": "string",
      "description": "24h format HH:MM"
    },
    "timezone": {
      "type": "string",
      "default": "America/Chicago"
    }
  },
  "required": [
    "user_id"
  ]
}