{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "entity_type": {
      "type": "string"
    },
    "entity_id": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "create",
        "update",
        "delete",
        "verify",
        "approve",
        "reject",
        "suspend",
        "restore",
        "export",
        "view"
      ]
    },
    "actor_email": {
      "type": "string"
    },
    "actor_role": {
      "type": "string"
    },
    "changes": {
      "type": "object",
      "description": "Before and after values"
    },
    "ip_address": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "entity_type",
    "action",
    "actor_email"
  ]
}